# Required: set a strong, unique password before the first start.
BLOG_ADMIN_PASSWORD=

# Optional: defaults are shown below. Keep the ports distinct when running both.
# BLOG_ADMIN_USERNAME=admin
# BLOG_BIND_ADDRESS=127.0.0.1
# BLOG_NATIVE_PORT=8081
# BLOG_JAR_PORT=8082
# BLOG_TYPEWRITER_ZONE=Asia/Shanghai

# Set these to the public URLs when using a reverse proxy or external domain.
# BLOG_NATIVE_SITE_URL=https://native.example.com
# BLOG_JAR_SITE_URL=https://blog.example.com

# To use an image imported with docker load, set its matching tag (arm64 or amd64).
# BLOG_NATIVE_IMAGE=blog:alpine-arm64
